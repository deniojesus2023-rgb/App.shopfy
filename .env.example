# Postgres. Em produção, use uma connection string com pooling (ex.: PgBouncer
# / Prisma Accelerate / Neon pooled connection) — funções serverless da Vercel
# abrem uma conexão por invocação.
DATABASE_URL="postgresql://user:password@localhost:5432/app_shopfy"

# Clerk — https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk -> Webhooks -> Add Endpoint (/api/webhooks/clerk) -> Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# URL pública da aplicação, usada para montar links de convite e callbacks OAuth/webhook.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shopify — partners.shopify.com -> Apps -> seu app -> Client credentials.
# Em dev, use `ngrok`/`cloudflared` e configure a Allowed redirection URL
# como <sua-url>/api/shopify/oauth/callback.
SHOPIFY_API_KEY="..."
SHOPIFY_API_SECRET="..."

# Chave AES-256 (32 bytes em base64) para criptografar access tokens da
# Shopify em repouso. Gerar com: openssl rand -base64 32
# Nunca reutilizar entre ambientes; perder esta chave torna as lojas
# conectadas irrecuperáveis (é preciso reconectar via OAuth).
SHOPIFY_TOKEN_ENCRYPTION_KEY="..."
