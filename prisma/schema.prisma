// Fase 0 — Fundação: Identity, Workspaces, Audit.
// Todo modelo de domínio futuro (Shopify, Catalog, Funnels, Orders, ...)
// deve seguir o mesmo padrão: workspaceId obrigatório + índice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships           WorkspaceMember[]
  sentInvitations       Invitation[]        @relation("InvitationsSentByUser")
  auditLogs             AuditLog[]
  shopifyOAuthStates    ShopifyOAuthState[]
  createdFunnels        Funnel[]
  createdFunnelVersions FunnelVersion[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Workspaces (tenants)
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              WorkspaceMember[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  shopifyStores        ShopifyStore[]
  shopifyOAuthStates   ShopifyOAuthState[]
  shopifyWebhookEvents ShopifyWebhookEvent[]
  catalogSyncRuns      CatalogSyncRun[]
  products             Product[]
  productVariants      ProductVariant[]
  funnels              Funnel[]
  funnelVersions       FunnelVersion[]
  funnelProducts       FunnelProduct[]
  codLeads             CodLead[]
  orders               Order[]
  orderItems           OrderItem[]
  orderStatusHistory   OrderStatusHistory[]
  onlineCheckouts      OnlineCheckoutAttempt[]

  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Um usuário só pode ter um vínculo (papel) por workspace.
  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id              String           @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole
  // Hash do token real (o token em claro só existe no link enviado ao convidado).
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationsSentByUser", fields: [invitedByUserId], references: [id])

  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Shopify — Fase 1A (OAuth + conexão de loja + webhooks)
// ---------------------------------------------------------------------------

enum ShopifyStoreStatus {
  CONNECTED
  DISCONNECTED
  REAUTH_REQUIRED
}

model ShopifyStore {
  id                   String             @id @default(cuid())
  workspaceId          String
  shopDomain           String             @unique
  displayName          String?
  // Criptografado (AES-256-GCM) — nunca lido fora de modules/shopify/encryption.ts.
  // Null quando desconectada: não guardamos um token utilizável sem necessidade.
  accessTokenEncrypted String?
  scopes               String
  status               ShopifyStoreStatus @default(CONNECTED)
  // ISO 4217, lida de `shop.currencyCode` na conexão (Fase 3). Nunca
  // hardcoded por país — apenas o fallback (quando a Shopify não retornar,
  // ou para lojas conectadas antes desta fase) usa "COP" como default do
  // primeiro mercado, sem travar a arquitetura a um único país.
  currency             String             @default("COP")
  installedAt          DateTime           @default(now())
  disconnectedAt       DateTime?
  lastSyncAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  webhookEvents   ShopifyWebhookEvent[]
  catalogSyncRuns CatalogSyncRun[]
  products        Product[]
  funnels         Funnel[]
  orders          Order[]
  onlineCheckouts OnlineCheckoutAttempt[]

  @@index([workspaceId])
  @@map("shopify_stores")
}

enum ShopifyOAuthStatePurpose {
  CONNECT
}

/// Estado de uso único do fluxo OAuth. Uma linha por tentativa de conexão;
/// `consumedAt` é setado atomicamente no callback para impedir replay do
/// mesmo `state` (CSRF / captura de URL).
model ShopifyOAuthState {
  id          String                   @id @default(cuid())
  state       String                   @unique
  workspaceId String
  userId      String
  shopDomain  String
  purpose     ShopifyOAuthStatePurpose @default(CONNECT)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime                 @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
  @@map("shopify_oauth_states")
}

enum ShopifyWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model ShopifyWebhookEvent {
  id               String                    @id @default(cuid())
  workspaceId      String?
  shopifyStoreId   String?
  shopDomain       String
  topic            String
  shopifyWebhookId String                    @unique
  payload          Json
  receivedAt       DateTime                  @default(now())
  processedAt      DateTime?
  status           ShopifyWebhookEventStatus @default(RECEIVED)
  error            String?

  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  shopifyStore ShopifyStore? @relation(fields: [shopifyStoreId], references: [id], onDelete: SetNull)

  @@index([shopDomain, topic])
  @@index([status])
  @@map("shopify_webhook_events")
}

// ---------------------------------------------------------------------------
// Fila persistente (Postgres) — Fase 1B
// ---------------------------------------------------------------------------

enum BackgroundJobType {
  SHOPIFY_FULL_CATALOG_SYNC
  SHOPIFY_PRODUCT_SYNC
  SHOPIFY_PRODUCT_DELETE
  SHOPIFY_ORDER_CREATE
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Fila de jobs em Postgres. `claimNext` (modules/queue/service.ts) usa
/// `UPDATE ... WHERE id = (SELECT ... FOR UPDATE SKIP LOCKED)` — o padrão
/// canônico para impedir dois workers pegarem o mesmo job, sem precisar de
/// Redis/SQS nesta fase.
model BackgroundJob {
  id          String              @id @default(cuid())
  workspaceId String?
  type        BackgroundJobType
  payload     Json
  status      BackgroundJobStatus @default(PENDING)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  runAt       DateTime            @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  completedAt DateTime?

  @@index([status, runAt])
  @@map("background_jobs")
}

// ---------------------------------------------------------------------------
// Catálogo — Fase 1B (produtos e variantes importados da Shopify)
// ---------------------------------------------------------------------------

enum CatalogSyncType {
  FULL
  INCREMENTAL
}

enum CatalogSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Uma linha por execução de sincronização. `productsProcessed`/
/// `variantsProcessed` alimentam o card "Última sincronização" na UI.
/// Reconciliação de produtos removidos (ver Product.lastSeenSyncRunId) só
/// acontece depois que um run FULL chega em COMPLETED.
model CatalogSyncRun {
  id                String            @id @default(cuid())
  workspaceId       String
  shopifyStoreId    String
  type              CatalogSyncType
  status            CatalogSyncStatus @default(PENDING)
  startedAt         DateTime?
  finishedAt        DateTime?
  productsProcessed Int               @default(0)
  variantsProcessed Int               @default(0)
  error             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shopifyStore ShopifyStore @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([shopifyStoreId, createdAt])
  @@map("catalog_sync_runs")
}

enum ShopifyProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

model Product {
  id                String               @id @default(cuid())
  workspaceId       String
  shopifyStoreId    String
  // GID completo da Shopify (ex.: "gid://shopify/Product/123456789") — nunca
  // assumir que cabe em Int.
  shopifyProductId  String
  title             String
  handle            String
  description       String?              @db.Text
  descriptionHtml   String?              @db.Text
  vendor            String?
  productType       String?
  status            ShopifyProductStatus
  featuredImageUrl  String?
  shopifyCreatedAt  DateTime?
  shopifyUpdatedAt  DateTime?
  syncedAt          DateTime             @default(now())
  // Marcador de reconciliação: setado para o CatalogSyncRun.id do full sync
  // que mais recentemente viu este produto. Um produto cujo marcador não
  // bate com o run atual, ao final de um run COMPLETED, foi removido na
  // Shopify — nunca durante um run em andamento ou que falhou no meio.
  lastSeenSyncRunId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shopifyStore   ShopifyStore     @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  lastSeenRun    CatalogSyncRun?  @relation(fields: [lastSeenSyncRunId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  funnelProducts FunnelProduct[]

  @@unique([shopifyStoreId, shopifyProductId])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, status])
  @@index([shopifyStoreId, lastSeenSyncRunId])
  @@map("products")
}

model ProductVariant {
  id                String    @id @default(cuid())
  workspaceId       String
  productId         String
  // Denormalizado do Product pai — permite unicidade e escopo de tenant
  // direto na variante, sem depender de join.
  shopifyStoreId    String
  shopifyVariantId  String
  title             String
  sku               String?
  barcode           String?
  price             Decimal   @db.Decimal(12, 2)
  compareAtPrice    Decimal?  @db.Decimal(12, 2)
  inventoryQuantity Int?
  availableForSale  Boolean   @default(true)
  // Posição na lista de variantes do produto (a Admin API não expõe mais um
  // campo `position` em ProductVariant — deriva-se do índice de retorno).
  position          Int
  imageUrl          String?
  shopifyCreatedAt  DateTime?
  shopifyUpdatedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([shopifyStoreId, shopifyVariantId])
  @@index([workspaceId])
  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Funnels — Fase 2A (motor de configuração: draft, versão, publicação)
// ---------------------------------------------------------------------------

enum FunnelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Funnel {
  id                 String       @id @default(cuid())
  workspaceId        String
  shopifyStoreId     String
  name               String
  slug               String
  // Identificador de resolução pública (/f/[publicId]/[slug]) — aleatório
  // (crypto.randomBytes, não derivado de slug/nome/id), nunca substitui
  // autorização interna. O storefront público resolve por isto, nunca por
  // workspaceId/shopifyStoreId vindos do client.
  publicId           String       @unique
  status             FunnelStatus @default(DRAFT)
  publishedVersionId String?      @unique
  createdByUserId    String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  archivedAt         DateTime?

  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shopifyStore     ShopifyStore            @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  createdBy        User                    @relation(fields: [createdByUserId], references: [id])
  // 1–1 com a versão atualmente publicada. Nula enquanto o funil nunca foi
  // publicado. Nunca aponta para uma versão DRAFT ou SUPERSEDED.
  publishedVersion FunnelVersion?          @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  versions         FunnelVersion[]         @relation("FunnelVersions")
  products         FunnelProduct[]
  orders           Order[]
  onlineCheckouts  OnlineCheckoutAttempt[]

  // Slug único por workspace (não globalmente) — domínio próprio é fase futura.
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([shopifyStoreId])
  @@map("funnels")
}

enum FunnelVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

/// Uma versão é imutável assim que passa a PUBLISHED — nenhuma rota da
/// aplicação faz `update` de `config` numa versão que não esteja DRAFT.
/// `revision` é o campo de optimistic concurrency: todo update de draft usa
/// `WHERE id = ? AND revision = ?`, incrementando `revision` no mesmo update.
model FunnelVersion {
  id                  String              @id @default(cuid())
  workspaceId         String
  funnelId            String
  versionNumber       Int
  configSchemaVersion Int
  config              Json
  status              FunnelVersionStatus @default(DRAFT)
  revision            Int                 @default(0)
  createdByUserId     String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  publishedAt         DateTime?
  // Setado quando esta versão deixa de ser a PUBLISHED atual (outra versão
  // a supersede). Usado só pela política de "version race" do checkout
  // (Fase 3): uma sessão iniciada nesta versão ainda pode concluir a compra
  // por uma janela curta depois disso — ver modules/orders/version-window.ts.
  supersededAt        DateTime?

  workspace          Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  funnel             Funnel                  @relation("FunnelVersions", fields: [funnelId], references: [id], onDelete: Cascade)
  createdBy          User                    @relation(fields: [createdByUserId], references: [id])
  publishedForFunnel Funnel?                 @relation("PublishedVersion")
  productSnapshot    FunnelProductSnapshot?
  orders             Order[]
  onlineCheckouts    OnlineCheckoutAttempt[]

  @@unique([funnelId, versionNumber])
  @@index([funnelId, status])
  @@map("funnel_versions")
}

/// Snapshot do produto PRIMARY no momento da publicação. Um funil publicado
/// não deve mudar de aparência porque o catálogo foi ressincronizado depois
/// — o storefront público lê SEMPRE daqui, nunca do Product/ProductVariant
/// ao vivo. `unitPrice` é a base para o cálculo de preço por quantidade no
/// OFFER step (unitPrice × quantity — mecanismo simples e explícito, sem
/// pricing rules ainda).
model FunnelProductSnapshot {
  id              String @id @default(cuid())
  funnelVersionId String @unique
  productId       String

  // Identidade da VARIANTE cujo preço foi congelado em `unitPrice`. A
  // publicação já escolhe uma variante concreta para ler o preço — congelar
  // a identidade dela aqui é o que permite ao pedido saber DEPOIS o que
  // exatamente foi vendido (line item real na Shopify, e futuramente
  // SupplierOrder lendo variante + quantidade sem interpretar texto).
  // Nullable porque snapshots publicados antes desta mudança não a têm —
  // esses continuam válidos e viram custom line item, sem migração
  // destrutiva de versão publicada.
  productVariantId String?
  shopifyProductId String?
  shopifyVariantId String?
  variantTitle     String?
  sku              String?

  title            String
  featuredImageUrl String?
  unitPrice        Decimal  @db.Decimal(12, 2)
  compareAtPrice   Decimal? @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  funnelVersion FunnelVersion @relation(fields: [funnelVersionId], references: [id], onDelete: Cascade)

  @@map("funnel_product_snapshots")
}

enum FunnelProductRole {
  PRIMARY
  UPSELL
  DOWNSELL
}

model FunnelProduct {
  id          String            @id @default(cuid())
  workspaceId String
  funnelId    String
  productId   String
  role        FunnelProductRole @default(PRIMARY)
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  funnel    Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([funnelId, productId])
  @@index([funnelId])
  @@index([productId])
  @@map("funnel_products")
}

/// Templates são globais (não pertencem a um workspace) — catálogo
/// compartilhado por toda a plataforma.
model FunnelTemplate {
  id                  String   @id @default(cuid())
  key                 String   @unique
  name                String
  description         String?
  configSchemaVersion Int
  defaultConfig       Json
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("funnel_templates")
}

// ---------------------------------------------------------------------------
// Orders — Fase 3 (COD Engine + Order Engine + criação de pedido na Shopify)
//
// Nossa aplicação é a autoridade inicial do pedido COD: o Order local é
// criado numa transação Postgres antes de qualquer chamada à Shopify (que é
// downstream). PII do cliente vive só em CodLead — Order/OrderItem/
// OrderStatusHistory nunca carregam nome/telefone/endereço, para que log,
// AuditLog e BackgroundJob.payload nunca vazem PII por conveniência.
// ---------------------------------------------------------------------------

/// Todo dado pessoal do cliente do pedido COD vive aqui, e só aqui.
/// Imutável após criado (nunca é `update`d pelo worker Shopify nem por
/// reconciliação de webhook) — é o registro histórico confiável do que o
/// cliente informou no momento da compra.
model CodLead {
  id              String  @id @default(cuid())
  workspaceId     String
  shopifyStoreId  String
  funnelId        String
  funnelVersionId String
  // Sessão do runtime público (não é PII — UUID gerado no client) — só para
  // suporte/depuração, nunca usado como chave de idempotência (isso é
  // Order.idempotencyKey, derivado do checkoutAttemptId).
  publicSessionId String?

  name             String
  phone            String
  whatsapp         String?
  country          String
  state            String
  city             String
  address          String
  addressReference String?
  // Normalização best-effort (dígitos), útil para sinalização futura de
  // duplicidade — nunca usado para bloquear automaticamente (ver Order.md).
  normalizedPhone  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order?

  @@index([workspaceId])
  @@map("cod_leads")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FULFILLED
  DELIVERED
  REFUSED
}

/// Estado da integração com a Shopify — eixo independente de `OrderStatus`.
/// `Order.status = PENDING` nunca significa "sincronização falhou": são
/// conceitos diferentes (ver README, Fase 3).
enum ShopifySyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  REAUTH_REQUIRED
  // Reconciliação encontrou MAIS DE UM pedido na Shopify com o nosso
  // `sourceIdentifier` (duplicata externa). Falha fechada: o worker nunca
  // cria outro pedido nem escolhe um dos candidatos sozinho — precisa de
  // decisão humana sobre qual manter/cancelar na Shopify.
  MANUAL_REVIEW
}

enum OrderPaymentMethod {
  COD
  ONLINE
}

// Quem executaria/executou o checkout deste pedido — congelado no momento
// da criação (Fase 4C), nunca dependente da config atual do Funnel: um
// relatório futuro precisa saber onde um pedido antigo foi processado sem
// reconsultar um PAYMENT_CHOICE que pode ter mudado desde então. Nesta
// fase só INTERNAL_COD cria Order de verdade — os outros dois existem no
// enum porque o CheckoutProvider já é modelado (config/checkout-provider.ts)
// e persistir o campo agora evita um backfill doloroso quando ONLINE virar
// real, mas nenhum Order com SHOPIFY_CHECKOUT/YAMPI existe ainda.
enum OrderCheckoutProvider {
  INTERNAL_COD
  SHOPIFY_CHECKOUT
  YAMPI
}

model Order {
  id              String  @id @default(cuid())
  workspaceId     String
  shopifyStoreId  String
  funnelId        String
  funnelVersionId String
  // Nulo para pedidos ONLINE (Fase 4D): o cliente preenche nome/endereço
  // dentro do checkout da Shopify, não no nosso funil — não existe CodLead
  // nesse fluxo. Continua obrigatório na prática para COD, onde o Order só
  // é criado junto com o lead na mesma transação.
  codLeadId       String? @unique

  // Identificador de resolução pública (endpoint de confirmação, futuro
  // rastreio) — aleatório, nunca sequencial/previsível.
  publicOrderId String @unique
  // Amigável para exibição interna (1048, 1049, ...) — sequência própria do
  // Postgres, nunca exposto como chave de busca em endpoint público sensível.
  orderNumber   Int    @default(autoincrement())

  // Deriva de `checkoutAttemptId` (gerado 1x no client, não é PII) — dois
  // submits do mesmo attempt colidem aqui e retornam o mesmo Order.
  idempotencyKey String @unique

  status           OrderStatus           @default(PENDING)
  paymentMethod    OrderPaymentMethod
  // Congelado no momento da criação (ver comentário do enum) — nunca
  // reconsultado da config do Funnel depois. Default INTERNAL_COD é seguro
  // para linhas existentes: todo Order criado antes desta fase era COD.
  checkoutProvider OrderCheckoutProvider @default(INTERNAL_COD)

  // ISO 4217. Resolvido de ShopifyStore.currency no momento da compra.
  currency String

  subtotal              Decimal @db.Decimal(12, 2)
  // Soma de offerDiscount + paymentMethodDiscount (Fase 4C) — granularidade
  // fina fica em `paymentMethodDiscount` abaixo; este campo continua tendo
  // o mesmo papel de sempre (total - subtotal, ignorando frete).
  discountTotal         Decimal @db.Decimal(12, 2)
  // Parcela de `discountTotal` que veio do MÉTODO DE PAGAMENTO escolhido
  // (Fase 4C), nunca da oferta — permite reconstruir depois "quanto deste
  // pedido veio de desconto por pagar online" sem depender de nada além do
  // próprio Order. Sempre 0 para pedidos sem desconto de pagamento
  // (inclusive todo Order anterior a esta fase).
  paymentMethodDiscount Decimal @default(0) @db.Decimal(12, 2)
  shippingTotal         Decimal @db.Decimal(12, 2)
  total                 Decimal @db.Decimal(12, 2)

  shopifyOrderId    String?
  shopifyOrderName  String?
  shopifySyncStatus ShopifySyncStatus @default(PENDING)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  shopifyCreatedAt DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?

  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shopifyStore   ShopifyStore           @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  funnel         Funnel                 @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  funnelVersion  FunnelVersion          @relation(fields: [funnelVersionId], references: [id], onDelete: Cascade)
  codLead        CodLead?               @relation(fields: [codLeadId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  onlineCheckout OnlineCheckoutAttempt?

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([shopifyOrderId])
  @@map("orders")
}

/// Snapshot congelado do item comprado — nunca depende do Product atual
/// para reconstruir um pedido histórico (o catálogo pode ressincronizar e
/// mudar título/preço/imagem depois da compra).
model OrderItem {
  id          String @id @default(cuid())
  workspaceId String
  orderId     String

  productId        String?
  productVariantId String?
  shopifyProductId String?
  shopifyVariantId String?

  titleSnapshot        String
  variantTitleSnapshot String?
  imageSnapshot        String?
  skuSnapshot          String?

  quantity      Int
  unitPrice     Decimal @db.Decimal(12, 2)
  lineSubtotal  Decimal @db.Decimal(12, 2)
  discountTotal Decimal @db.Decimal(12, 2)
  lineTotal     Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([workspaceId])
  @@map("order_items")
}

enum OrderStatusSource {
  STOREFRONT
  SYSTEM
  SHOPIFY
  ADMIN
}

model OrderStatusHistory {
  id          String            @id @default(cuid())
  workspaceId String
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  source      OrderStatusSource
  metadata    Json?
  createdAt   DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Checkout ONLINE — Fase 4D (Draft Order + invoiceUrl)
// ---------------------------------------------------------------------------

/// Estados do ciclo de vida de uma tentativa de checkout online.
/// Deliberadamente pequeno — não é uma máquina de estados de pagamento.
/// `COMPLETED` significa "o pedido Shopify correspondente apareceu e foi
/// reconciliado", NUNCA "o cliente abriu o invoiceUrl" (Fase 4D item 14:
/// checkout criado ≠ pedido criado ≠ pagamento confirmado).
enum OnlineCheckoutStatus {
  PENDING
  CREATING
  READY
  COMPLETED
  EXPIRED
  FAILED
  MANUAL_REVIEW
}

/// Tentativa de checkout ONLINE. Deliberadamente NÃO é um Order: nenhum
/// pedido local existe antes do pagamento (Fase 4D item 5/12) — o Order
/// local ONLINE só nasce pela reconciliação do webhook `orders/create`.
///
/// Não guarda NENHUMA PII: o cliente preenche nome/endereço dentro do
/// checkout da Shopify, não no nosso funil. O que fica aqui é a identidade
/// da tentativa, o quote congelado e os ponteiros para o draft order.
model OnlineCheckoutAttempt {
  id              String @id @default(cuid())
  workspaceId     String
  shopifyStoreId  String
  funnelId        String
  funnelVersionId String

  /// Derivada de `funnelId:checkoutAttemptId` — mesma estratégia de
  /// idempotência do `Order.idempotencyKey` (Fase 3). Dois cliques do
  /// mesmo attempt colidem aqui e reutilizam o mesmo draft order.
  idempotencyKey    String @unique
  /// UUID gerado uma vez no client (não é PII) — guardado para suporte.
  checkoutAttemptId String

  selectedOfferId         String?
  selectedPaymentMethodId String?

  currency         String
  /// Quote congelado no momento da criação (o mesmo objeto que
  /// `calculateOrderQuote` devolveu) — é o que foi projetado no draft
  /// order, e a única forma de auditar depois o que prometemos cobrar.
  /// MERCHANDISE apenas: frete/impostos são adicionados pela Shopify no
  /// checkout e nunca estiveram neste número (ver README).
  quoteSnapshot    Json
  /// Espelha `quoteSnapshot.total` numa coluna consultável.
  merchandiseTotal Decimal @db.Decimal(12, 2)

  status OnlineCheckoutStatus @default(PENDING)

  shopifyDraftOrderId   String?
  shopifyDraftOrderName String?
  /// `DraftOrder.invoiceUrl` — o link de checkout da Shopify.
  checkoutUrl           String?

  /// Order local criado pela reconciliação do webhook, quando o cliente
  /// efetivamente pagou. Null enquanto o pagamento não aconteceu.
  orderId String? @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expiresAt   DateTime
  completedAt DateTime?

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shopifyStore  ShopifyStore  @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)
  funnel        Funnel        @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  funnelVersion FunnelVersion @relation(fields: [funnelVersionId], references: [id], onDelete: Cascade)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([status, expiresAt])
  @@index([shopifyDraftOrderId])
  @@map("online_checkout_attempts")
}
